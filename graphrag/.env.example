KINETICA_DB_SKILL_URL=http://127.0.0.1:9191
KINETICA_DB_SKILL_USER=admin
KINETICA_DB_SKILL_PASS=
KINETICA_DB_SKILL_TIMEOUT=30000

# Optional. When unset or 'off', kgr disambiguates by exact (NODE, LABEL) only.
# When 'on', kgr calls GENERATE_EMBEDDINGS using KGR_EMBEDDING_MODEL.
KGR_EMBEDDINGS=off
KGR_EMBEDDING_MODEL=openai_remote_model
KGR_EMBEDDING_DIM=1536
KGR_DISAMBIG_THRESHOLD=0.15

# For the LLM enrichment extractor (Claude). Leave empty to skip enrichment.
ANTHROPIC_API_KEY=
KGR_LLM_MODEL=claude-opus-4-7
